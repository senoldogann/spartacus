# RepoBench Environment Variables

# Database
DATABASE_URL=postgresql://repobench:repobench@localhost:5432/repobench

# Redis
REDIS_URL=redis://localhost:6379

# Artifact persistence
ARTIFACTS_DIR=.repobench-artifacts

# Reserved for upcoming S3-compatible artifact store integration
ARTIFACT_STORE_ENDPOINT=http://localhost:9000
ARTIFACT_STORE_ACCESS_KEY=minioadmin
ARTIFACT_STORE_SECRET_KEY=minioadmin
ARTIFACT_STORE_BUCKET=repobench-artifacts

# GitHub
GITHUB_TOKEN=

# LLM Providers (at least one required for running benchmarks)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Safety gate for off-box provider calls
ALLOW_HOSTED_AGENT_EXECUTION=false

# API
# SECURITY: Generate a strong bearer token before exposing the API outside local development.
API_AUTH_TOKEN=change-me
API_PORT=3001
API_HOST=0.0.0.0

# Web Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001

# Worker
WORKER_CONCURRENCY=2

# Sandbox
SANDBOX_TIMEOUT_MS=300000
SANDBOX_DOCKER_IMAGE=repobench/sandbox:latest
