{
  "name": "repobench",
  "version": "0.0.1",
  "private": true,
  "description": "Benchmark coding agents on your own repository history",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/repobench/repobench.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "if [ -f ./.env ]; then set -a; . ./.env; set +a; fi; pnpm exec vitest run --config vitest.config.ts --project integration",
    "test:e2e": "pnpm --filter @repobench/cli build && if [ -f ./.env ]; then set -a; . ./.env; set +a; fi; pnpm exec playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "turbo run db:migrate --filter=@repobench/storage",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "bullmq": "^5.74.1",
    "eslint": "^10.2.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
